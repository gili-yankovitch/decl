// CH32V003 Development Board
// TSSOP20 variant with SPI flash, USART debug header, and status LED.
// Demonstrates: protocols, variants, multi-feature IC, discrete components.

import "../stdlib/protocols/spi.decl"
import "../stdlib/protocols/i2c.decl"
import "../stdlib/protocols/usart.decl"
import "../stdlib/components/resistor.decl"
import "../stdlib/components/capacitor.decl"
import "../stdlib/components/led.decl"
import "../stdlib/components/ch32v003.decl"

// ---- SPI Flash ----

component W25Q32JV {
    pins {
        1: Input       as CS
        2: Output      as DO
        3: Unconnected as WP
        4: PowerInput  as GND
        5: Input       as DI
        6: Input       as CLK
        7: Unconnected as HOLD
        8: PowerInput  as VCC
    }

    features {
        internal flash {
            size: 4MB
        }

        external SPI using protocol SPI role slave {
            SS   -> pin 1
            MISO -> pin 2
            MOSI -> pin 5
            CLK  -> pin 6
        }
    }
}

// ---- USART Debug Header (directly exposes TX/RX) ----

component DebugHeader {
    pins {
        1: Output as TX
        2: Input  as RX
        3: PowerInput as GND
    }

    features {
        external USART using protocol USART role peer {
            TX  -> pin 1
            RX  -> pin 2
            CK  -> pin 1
            CTS -> pin 2
            RTS -> pin 1
        }
    }
}

// ---- Schematic ----

schematic CH32V003_DevBoard {
    // MCU (TSSOP20 package variant)
    instance mcu: CH32V003F4P6

    // SPI flash
    instance flash: W25Q32JV

    // Passive components
    instance r_led:   Resistor  { resistance = 1kohm }
    instance c_byp1:  Capacitor { capacitance = 100nF }
    instance c_bulk:  Capacitor { capacitance = 10uF }
    instance r_reset: Resistor  { resistance = 10kohm }

    // LED on PD0
    instance led: LED { color = "green" }

    // Named nets
    net VCC_3V3
    net GND

    // ---- Power ----
    connect mcu.VDD -- net VCC_3V3
    connect mcu.VSS -- net GND

    // Bypass caps across power rails
    connect c_byp1.positive -- net VCC_3V3
    connect c_byp1.negative -- net GND
    connect c_bulk.positive -- net VCC_3V3
    connect c_bulk.negative -- net GND

    // Flash power
    connect flash.VCC -- net VCC_3V3
    connect flash.GND -- net GND

    // ---- Reset pull-up ----
    connect r_reset.A -- net VCC_3V3
    connect r_reset.B -- mcu.PD7

    // ---- LED circuit: MCU PD0 -> resistor -> LED -> GND ----
    connect r_led.A      -- mcu.PD0
    connect r_led.B      -- led.anode
    connect led.cathode  -- net GND

    // ---- SPI bus: MCU <-> Flash ----
    wire SPI {
        master: mcu
        slave:  flash
    }
}
