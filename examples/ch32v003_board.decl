// CH32V003 Development Board
// TSSOP20 variant with SPI flash, USART debug header, and status LED.
// Demonstrates: protocols, variants, multi-feature IC, discrete components.

// ---- Protocols ----

protocol SPI {
    lines { MOSI MISO SCK NSS }
    role master { MOSI: Output  MISO: Input  SCK: Output  NSS: Output }
    role slave  { MOSI: Input   MISO: Output SCK: Input   NSS: Input  }
    rules {
        master.MOSI -- slave.MOSI
        slave.MISO  -- master.MISO
        master.SCK  -- slave.SCK
        master.NSS  -- slave.NSS
    }
}

protocol I2C {
    lines { SDA SCL }
    role master { SDA: OpenDrain  SCL: OpenDrain }
    role slave  { SDA: OpenDrain  SCL: Input     }
    rules {
        master.SDA -- slave.SDA
        master.SCL -- slave.SCL
    }
}

protocol USART {
    lines { TX RX CK CTS RTS }
    role endpoint {
        TX:  Output
        RX:  Input
        CK:  Output
        CTS: Input
        RTS: Output
    }
    role peer {
        TX:  Output
        RX:  Input
        CK:  Input
        CTS: Input
        RTS: Output
    }
    rules {
        endpoint.TX  -- peer.RX
        peer.TX      -- endpoint.RX
        endpoint.CK  -- peer.CK
        endpoint.RTS -- peer.CTS
        peer.RTS     -- endpoint.CTS
    }
}

// ---- Discrete Components ----

component Resistor {
    pins {
        1: Passive as A
        2: Passive as B
    }
    attributes {
        resistance:   Resistance
        tolerance:    Percentage = 5%
        power_rating: Power = 0.125W
    }
}

component Capacitor {
    pins {
        1: Passive as positive
        2: Passive as negative
    }
    attributes {
        capacitance:    Capacitance
        voltage_rating: Voltage = 16V
    }
}

component LED {
    pins {
        1: Passive as anode
        2: Passive as cathode
    }
    attributes {
        forward_voltage: Voltage = 2V
        max_current:     Current = 20mA
        color:           Color
    }
}

// ---- CH32V003 Base + TSSOP20 Variant ----

component CH32V003 {
    pins {
        PA1: Bidirectional
        PA2: Bidirectional
        PC0: Bidirectional
        PC1: Bidirectional
        PC2: Bidirectional
        PC3: Bidirectional
        PC4: Bidirectional
        PC5: Bidirectional
        PC6: Bidirectional
        PC7: Bidirectional
        PD0: Bidirectional
        PD1: Bidirectional
        PD2: Bidirectional
        PD3: Bidirectional
        PD4: Bidirectional
        PD5: Bidirectional
        PD6: Bidirectional
        PD7: Bidirectional
        VDD: PowerInput
        VSS: PowerInput
    }

    features {
        internal RISC_V2A_core {
            isa:           "RV32EC"
            max_frequency: 48MHz
        }

        internal flash {
            size: 16kB
        }

        internal SRAM {
            size: 2kB
        }

        internal HSI {
            frequency: 24MHz
        }

        external SPI using protocol SPI role master {
            SCK  -> pin PC5
            MOSI -> pin PC6
            MISO -> pin PC7
            NSS  -> pin PC1
        }

        external I2C using protocol I2C role master {
            SDA -> pin PC1
            SCL -> pin PC2
        }

        external USART using protocol USART role endpoint {
            TX  -> pin PD5
            RX  -> pin PD6
            CK  -> pin PD4
            CTS -> pin PD3
            RTS -> pin PC2
        }
    }

    attributes {
        voltage_range: VoltageRange(2.7V, 5.5V)
        max_frequency: Frequency = 48MHz
    }
}

variant CH32V003F4P6 of CH32V003 {
    package: "TSSOP20"
    pinout {
        PD4 -> 1
        PD5 -> 2
        PD6 -> 3
        PD7 -> 4
        PA1 -> 5
        PA2 -> 6
        VSS -> 7
        PD0 -> 8
        VDD -> 9
        PC0 -> 10
        PC1 -> 11
        PC2 -> 12
        PC3 -> 13
        PC4 -> 14
        PC5 -> 15
        PC6 -> 16
        PC7 -> 17
        PD1 -> 18
        PD2 -> 19
        PD3 -> 20
    }
}

// ---- SPI Flash ----

component W25Q32JV {
    pins {
        1: Input       as CS
        2: Output      as DO
        3: Unconnected as WP
        4: PowerInput  as GND
        5: Input       as DI
        6: Input       as CLK
        7: Unconnected as HOLD
        8: PowerInput  as VCC
    }

    features {
        internal flash {
            size: 4MB
        }

        external SPI using protocol SPI role slave {
            NSS  -> pin 1
            MISO -> pin 2
            MOSI -> pin 5
            SCK  -> pin 6
        }
    }
}

// ---- USART Debug Header (directly exposes TX/RX) ----

component DebugHeader {
    pins {
        1: Output as TX
        2: Input  as RX
        3: PowerInput as GND
    }

    features {
        external USART using protocol USART role peer {
            TX  -> pin 1
            RX  -> pin 2
            CK  -> pin 1
            CTS -> pin 2
            RTS -> pin 1
        }
    }
}

// ---- Schematic ----

schematic CH32V003_DevBoard {
    // MCU (TSSOP20 package variant)
    instance mcu: CH32V003F4P6

    // SPI flash
    instance flash: W25Q32JV

    // Passive components
    instance r_led:   Resistor  { resistance = 1kohm }
    instance c_byp1:  Capacitor { capacitance = 100nF }
    instance c_bulk:  Capacitor { capacitance = 10uF }
    instance r_reset: Resistor  { resistance = 10kohm }

    // LED on PD0
    instance led: LED { color = "green" }

    // Named nets
    net VCC_3V3
    net GND

    // ---- Power ----
    connect mcu.VDD -- net VCC_3V3
    connect mcu.VSS -- net GND

    // Bypass caps across power rails
    connect c_byp1.positive -- net VCC_3V3
    connect c_byp1.negative -- net GND
    connect c_bulk.positive -- net VCC_3V3
    connect c_bulk.negative -- net GND

    // Flash power
    connect flash.VCC -- net VCC_3V3
    connect flash.GND -- net GND

    // ---- Reset pull-up ----
    connect r_reset.A -- net VCC_3V3
    connect r_reset.B -- mcu.PD7

    // ---- LED circuit: MCU PD0 -> resistor -> LED -> GND ----
    connect r_led.A      -- mcu.PD0
    connect r_led.B      -- led.anode
    connect led.cathode  -- net GND

    // ---- SPI bus: MCU <-> Flash ----
    wire SPI {
        master: mcu
        slave:  flash
    }
}
