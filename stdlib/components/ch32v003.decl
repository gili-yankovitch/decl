// CH32V003 -- WCH QingKe RISC-V2A general-purpose MCU
// Based on the CH32V003 Datasheet V1.3
//
// This is the base component defining all logical pins and features.
// Use the variants below (CH32V003F4P6, CH32V003F4U6, etc.) for specific packages.

protocol SPI {
    lines { MOSI MISO SCK NSS }
    role master { MOSI: Output  MISO: Input  SCK: Output  NSS: Output }
    role slave  { MOSI: Input   MISO: Output SCK: Input   NSS: Input  }
    rules {
        master.MOSI -- slave.MOSI
        slave.MISO  -- master.MISO
        master.SCK  -- slave.SCK
        master.NSS  -- slave.NSS
    }
}

protocol I2C {
    lines { SDA SCL }
    role master { SDA: OpenDrain  SCL: OpenDrain }
    role slave  { SDA: OpenDrain  SCL: Input     }
    rules {
        master.SDA -- slave.SDA
        master.SCL -- slave.SCL
    }
}

protocol USART {
    lines { TX RX CK CTS RTS }
    role endpoint {
        TX:  Output
        RX:  Input
        CK:  Output
        CTS: Input
        RTS: Output
    }
    role peer {
        TX:  Output
        RX:  Input
        CK:  Input
        CTS: Input
        RTS: Output
    }
    rules {
        endpoint.TX  -- peer.RX
        peer.TX      -- endpoint.RX
        endpoint.CK  -- peer.CK
        endpoint.RTS -- peer.CTS
        peer.RTS     -- endpoint.CTS
    }
}

// ---------------------------------------------------------------------------
// Base component: all 18 GPIO + 2 power pins
// ---------------------------------------------------------------------------

component CH32V003 {
    pins {
        // Port A
        PA1: Bidirectional
        PA2: Bidirectional

        // Port C
        PC0: Bidirectional
        PC1: Bidirectional
        PC2: Bidirectional
        PC3: Bidirectional
        PC4: Bidirectional
        PC5: Bidirectional
        PC6: Bidirectional
        PC7: Bidirectional

        // Port D
        PD0: Bidirectional
        PD1: Bidirectional
        PD2: Bidirectional
        PD3: Bidirectional
        PD4: Bidirectional
        PD5: Bidirectional
        PD6: Bidirectional
        PD7: Bidirectional

        // Power
        VDD: PowerInput
        VSS: PowerInput
    }

    features {
        // ---- Internal features ----

        internal RISC_V2A_core {
            isa:           "RV32EC"
            max_frequency: 48MHz
        }

        internal flash {
            size: 16kB
        }

        internal SRAM {
            size: 2kB
        }

        internal HSI {
            frequency: 24MHz
        }

        internal LSI {
            frequency: 128kHz
        }

        internal ADC {
            resolution: 10
            channels:   8
        }

        internal DMA {
            channels: 7
        }

        // ---- External features (default pin mapping) ----

        external SPI using protocol SPI role master {
            SCK  -> pin PC5
            MOSI -> pin PC6
            MISO -> pin PC7
            NSS  -> pin PC1
        }

        external I2C using protocol I2C role master {
            SDA -> pin PC1
            SCL -> pin PC2
        }

        external USART using protocol USART role endpoint {
            TX  -> pin PD5
            RX  -> pin PD6
            CK  -> pin PD4
            CTS -> pin PD3
            RTS -> pin PC2
        }
    }

    attributes {
        voltage_range:    VoltageRange(2.7V, 5.5V)
        max_frequency:    Frequency = 48MHz
        temperature_range: TemperatureRange
        package:          Package
    }
}

// ---------------------------------------------------------------------------
// Package variants
// ---------------------------------------------------------------------------

// TSSOP20 -- 20 pins, all GPIO available
variant CH32V003F4P6 of CH32V003 {
    package: "TSSOP20"
    pinout {
        PD4 -> 1
        PD5 -> 2
        PD6 -> 3
        PD7 -> 4
        PA1 -> 5
        PA2 -> 6
        VSS -> 7
        PD0 -> 8
        VDD -> 9
        PC0 -> 10
        PC1 -> 11
        PC2 -> 12
        PC3 -> 13
        PC4 -> 14
        PC5 -> 15
        PC6 -> 16
        PC7 -> 17
        PD1 -> 18
        PD2 -> 19
        PD3 -> 20
    }
}

// QFN20 -- 20 pins, same GPIO set as TSSOP20
variant CH32V003F4U6 of CH32V003 {
    package: "QFN20"
    pinout {
        PC3 -> 1
        PC4 -> 2
        PC5 -> 3
        PC6 -> 4
        PC7 -> 5
        PD1 -> 6
        PD2 -> 7
        PD3 -> 8
        PD4 -> 9
        PD5 -> 10
        PD6 -> 11
        PD7 -> 12
        PA1 -> 13
        PA2 -> 14
        VSS -> 15
        PD0 -> 16
        VDD -> 17
        PC0 -> 18
        PC1 -> 19
        PC2 -> 20
    }
}

// SOP16 -- 16 pins, reduced GPIO (no PC5-PC7, PD0-PD2)
variant CH32V003A4M6 of CH32V003 {
    package: "SOP16"
    pinout {
        PD4 -> 1
        PD5 -> 2
        PD6 -> 3
        PD7 -> 4
        PA1 -> 5
        PA2 -> 6
        VSS -> 7
        VDD -> 8
        PC0 -> 9
        PC1 -> 10
        PC2 -> 11
        PC3 -> 12
        PC4 -> 13
        PD1 -> 14
        PD2 -> 15
        PD3 -> 16
    }
}

// SOP8 -- 8 pins, minimal GPIO
variant CH32V003J4M6 of CH32V003 {
    package: "SOP8"
    pinout {
        PD6 -> 1
        VSS -> 2
        PA2 -> 3
        VDD -> 4
        PC1 -> 5
        PC2 -> 6
        PC4 -> 7
        PD1 -> 8
    }
}
